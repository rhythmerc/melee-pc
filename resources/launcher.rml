<rml>
<head><title>Xelee</title><link type="text/rcss" href="launcher.rcss" /></head>
<!-- The body's classes are set by src/pc/launcher.cpp: the platform
     (desktop, mobile or quest, plus ios) hides what that platform has no use
     for, and theme-* colours the frame after the focused main-menu plate. -->
<body class="desktop theme-choose">
  <div id="frame">
    <div id="titlebar">
      <span id="title">Xelee</span><span id="title-sub">/ Settings</span>
      <span class="stripes"><span></span><span></span><span></span><span></span><span></span></span>
      <span id="edition"><span id="app-version">v0.1.8-beta</span> &#183; NTSC-U 1.02</span>
    </div>
    <div id="home">
      <div id="plates">
        <button id="play" class="plate" data-desc="Start Melee from this disc."><span>Play</span></button>
        <button id="choose" class="plate" data-desc="Pick a Melee disc image: ISO, GCM, CISO, RVZ, GCZ or WIA."><span>Choose Disc</span></button>
        <button id="verify" class="plate" data-desc="Check the disc image against the original NTSC-U 1.02 disc."><span id="verify-label">Verify Disc</span></button>
        <button id="settings" class="plate" data-desc="Graphics, audio, gameplay, controls, online play and the launcher itself."><span>Settings</span></button>
        <button id="quit" class="plate" data-desc="Close Xelee."><span>Quit</span></button>
      </div>
      <div id="side">
        <div id="update-card" style="display: none;">
          <div class="update-badge-row">
            <span class="update-badge">NEW</span>
            <span id="update-tag" class="update-tag">v0.1.8-beta</span>
          </div>
          <div id="update-title" class="update-title">Xelee Update</div>
          <p id="update-desc" class="update-desc">A newer version is available.</p>
          <div id="update-progress-row" class="update-progress-row" style="display: none;">
            <div class="progress-bar-bg">
              <div id="update-progress-fill" class="progress-bar-fill" style="width: 0%;"></div>
            </div>
            <span id="update-progress-text" class="progress-text">0%</span>
          </div>
          <div class="update-actions">
            <button id="update-action" class="mini primary" data-desc="Download the new version.">Update Now</button>
            <button id="update-browser" class="mini" data-desc="Open the release notes in the browser.">View Release</button>
            <button id="update-later" class="mini" data-desc="Hide this until the next start.">Later</button>
          </div>
        </div>
        <div id="disc-panel">
          <div class="side-label">Disc</div>
          <h2 id="disc-name">No disc selected</h2>
          <p id="disc-info">Melee, USA revision 2 (NTSC-U 1.02).</p>
          <p id="disc-path" class="path">ISO &#183; GCM &#183; CISO &#183; RVZ</p>
          <div id="status">No disc selected.</div>
          <p id="disc-note" class="note">Drop a disc image here, or use Choose Disc.</p>
        </div>
      </div>
    </div>
    <div id="preferences">
      <div id="categories">
        <button id="tab-graphics" class="plate small" data-desc="How the game looks."><span>Graphics</span></button>
        <button id="tab-audio" class="plate small" data-desc="Volume, reverb and spatial audio."><span>Audio</span></button>
        <button id="tab-cheats" class="plate small" data-desc="Unlocks, stage hazards and controller fixes."><span>Gameplay</span></button>
        <button id="tab-controls" class="plate small no-quest" data-desc="The keyboard layout and controller setup."><span>Controls</span></button>
        <button id="tab-online" class="plate small" data-desc="Your Slippi account and online play."><span>Online</span></button>
        <button id="tab-launcher" class="plate small" data-desc="Settings for the launcher itself."><span>Launcher</span></button>
        <button id="back" class="plate small back" data-desc="Back to the main menu."><span>Back</span></button>
      </div>
      <div id="settings-content">
        <div id="page-graphics" class="page">
          <div class="row no-mobile no-quest" data-desc="Windowed or fullscreen."><span class="name">Display mode</span><button id="display" class="value">Display</button></div>
          <div class="row no-quest" data-desc="Synchronise presentation with your display."><span class="name">Vertical sync</span><button id="sync" class="value">VSync</button></div>
          <div class="row no-quest" data-desc="How sharp the game renders. Auto follows the window size."><span class="name">Internal resolution</span>
            <div class="slider-control"><input type="range" class="range" id="resolution" min="0" max="10" step="1" value="0" /><span id="resolution-val" class="slider-value">Auto</span></div></div>
          <div class="row quest-only" data-desc="How sharp the headset renders, against its recommended size. Dynamic follows the load, between 80% and 130%."><span class="name">Resolution</span>
            <div class="slider-control"><input type="range" class="range" id="xr-resolution" min="80" max="140" step="10" value="140" /><span id="xr-resolution-val" class="slider-value">Dynamic</span></div></div>
          <div class="row quest-only" data-desc="Application SpaceWarp: the headset makes every other frame from the game's motion, so movement is smooth at 120 Hz. Off shows each frame twice."><span class="name">SpaceWarp (ASW)</span><button id="spacewarp" class="value">On</button></div>
          <div class="row quest-only" data-desc="Fixed foveated rendering: the edges of each eye, where the lenses are least sharp, are drawn at a lower resolution, leaving the GPU more room. Higher levels save more and soften more of the edges."><span class="name">Foveation</span><button id="xr-foveation" class="value">Off</button></div>
          <div class="row quest-only" data-desc="A soft shadow under the stage on the desk or table it sits over, found with the headset's depth sensing."><span class="name">Stage shadow</span><button id="xr-shadow" class="value">On</button></div>
          <div class="row quest-only" data-desc="Hold each fight's first frame to move, turn and size the stage, or start right away where your stage spot is. Either way, the pause moves it any time."><span class="name">Before each fight</span><button id="xr-place" class="value">Place the stage</button></div>
          <div class="row quest-only" data-desc="How fights are lit. Vanilla is Melee's own lighting. Roomtone (Beta) lights the fighters and the stage with your room's light, measured through the headset's cameras."><span class="name">Lighting</span><button id="xr-lighting" class="value pick">Vanilla</button></div>
          <div class="row no-quest" data-desc="Applies to fights. Menus and cutscenes keep the original aspect."><span class="name">Aspect ratio</span><button id="aspect" class="value">Original (73:60)</button></div>
          <div class="row no-quest" data-desc="Classic keeps 4:3 safe margins; Wide anchors damage and stocks to the 16:9 edges."><span class="name">HUD layout</span><button id="hud-mode" class="value">Classic (4:3)</button></div>
          <div class="row no-quest" data-desc="Smooth polygon edges with multisampling. Applies after a restart."><span class="name">Anti-aliasing <span class="badge">RESTART</span></span><button id="aa" class="value">Anti-aliasing</button></div>
          <!-- Hidden for now: Melee never asks for anisotropic filtering, so it does nothing. -->
          <div class="row" style="display: none;" data-desc="Sharper textures seen at an angle, where the texture allows it. Applies after a restart."><span class="name">Anisotropic filtering <span class="badge">RESTART</span></span><button id="filter" class="value">Filtering</button></div>
          <div class="row no-quest" data-desc="A filter over the finished frame. Off presents it as rendered."><span class="name">Post-processing</span><button id="filter-mode" class="value">Off</button></div>
          <div class="row no-quest" data-desc="Show the frame rate in a corner of the screen."><span class="name">FPS counter</span><button id="fps" class="value">FPS counter</button></div>
          <div class="row" data-desc="Load replacement textures from the textures folder."><span class="name">Custom HD textures</span><button id="custom-textures" class="value">Enabled</button></div>
          <div class="row no-quest" data-desc="Auto, or a specific graphics API this platform provides. Applies after a restart."><span class="name">Graphics backend <span class="badge">RESTART</span></span><button id="backend" class="value">Auto</button></div>
          <div class="row no-quest" data-desc="For slow devices: 1x internal resolution, no anti-aliasing and reverb off."><span class="name">Performance preset</span><button id="performance" class="value action">Apply</button></div>
          <div class="row" data-desc="Put the settings on this page back to how a new install has them."><span class="name">Defaults</span><button id="defaults-graphics" class="value action">Restore</button></div>
        </div>
        <div id="page-audio" class="page">
          <div class="row" data-desc="Everything the game plays. Left and right adjust it."><span class="name">Master volume</span>
            <div class="slider-control"><input type="range" class="range" id="volume" min="0" max="100" step="5" value="100" /><span id="volume-val" class="slider-value">100%</span></div></div>
          <div class="row" data-desc="Background music."><span class="name">Music volume</span>
            <div class="slider-control"><input type="range" class="range" id="music-volume" min="0" max="100" step="5" value="100" /><span id="music-volume-val" class="slider-value">100%</span></div></div>
          <div class="row" data-desc="Sound effects, voices and combat audio."><span class="name">SFX volume</span>
            <div class="slider-control"><input type="range" class="range" id="sfx-volume" min="0" max="100" step="5" value="100" /><span id="sfx-volume-val" class="slider-value">100%</span></div></div>
          <div class="row" data-desc="Silence the game without changing the volumes."><span class="name">Mute</span><button id="mute" class="value">Mute</button></div>
          <div class="row" data-desc="Stage reverb and echo. Off saves audio CPU on slow devices."><span class="name">Reverb</span><button id="reverb" class="value">On</button></div>
          <div class="row" id="spatial-row" data-desc="Fighters' and items' sounds come from where they are on the stage."><span class="name">Spatial audio</span><button id="spatial-audio" class="value">On</button></div>
          <div class="row" id="stage-sounds-row" data-desc="Sounds the stages lack, made for spatial audio, such as the wind on the Great Fox's deck at Corneria. Needs spatial audio."><span class="name">Expanded stage sounds</span><button id="stage-sounds" class="value">On</button></div>
          <div class="row" data-desc="Put the settings on this page back to how a new install has them."><span class="name">Defaults</span><button id="defaults-audio" class="value action">Restore</button></div>
        </div>
        <div id="page-cheats" class="page">
          <div class="row" data-desc="Unlock all 26 characters, the 11 secret stages and All-Star mode."><span class="name">Unlock everything</span><button id="unlock-all" class="value">Off</button></div>
          <div class="row" data-desc="Keep Pokémon Stadium in its neutral form, with no transformations."><span class="name">Hazardless stages</span><button id="frozen-stadium" class="value">Off</button></div>
          <div class="row no-quest" data-desc="Free the pause camera's rotation and zoom."><span class="name">Free camera</span><button id="free-camera" class="value">Normal</button></div>
          <div class="row" data-desc="UCF 0.84 as Slippi plays it: dashback, shield drop, SDI, tumble and 1.0 cardinals on any controller."><span class="name">Universal Controller Fix</span><button id="ucf" class="value">On</button></div>
          <div class="row" data-desc="Slippi's other rules offline: no wobbling, neutral spawns and the Ice Climbers freeze-glitch fix. Always on online."><span class="name">Slippi gameplay fixes</span><button id="slippi-fixes" class="value">On</button></div>
          <div class="row" data-desc="The C-stick's smash attacks and aerials in Classic, Adventure, Training and the other 1P modes, as in VS, instead of zooming the camera."><span class="name">C-Stick in 1P</span><button id="cstick-1p" class="value">On</button></div>
          <div class="row" data-desc="Put the settings on this page back to how a new install has them."><span class="name">Defaults</span><button id="defaults-cheats" class="value action">Restore</button></div>
        </div>
        <div id="page-controls" class="page">
          <div class="info no-mobile">
            <h3>Keyboard</h3>
            <p>WASD / arrows Move &#183; X Attack &#183; Z Special &#183; C / V Jump &#183; Q / E Shield<br/>Tab Grab &#183; Enter Start &#183; IJKL C-stick</p>
          </div>
          <div class="info">
            <h3>Controller</h3>
            <p>Remap a gamepad from the in-game menu: press BACK on the pad, or F1, then open Controls. Controllers are only detected once the game is running.</p>
          </div>
        </div>
        <div id="page-online" class="page">
          <div class="row" data-desc="Sign in with the email and password from slippi.gg."><span class="name">Slippi account <span id="auth-status" class="detail">Sign in with the email and password from slippi.gg.</span></span><button id="auth-sign-in" class="value action">Sign in</button><button id="auth-sign-out" class="value action" style="display:none">Sign out</button></div>
          <div id="auth-signed-out" class="row" data-desc="The email address on your Slippi account."><span class="name">Email</span><input type="text" id="auth-email" value="" /></div>
          <div id="auth-signed-out-pw" class="row" data-desc="Used only to sign in; never stored."><span class="name">Password</span><input type="password" id="auth-password" value="" /></div>
          <div id="auth-signed-in" class="row" style="display:none" data-desc="Your Slippi connect code."><span class="name">Connect code</span><span id="auth-code" class="readout"></span></div>
          <div id="auth-signed-in-n" class="row" style="display:none" data-desc="Your Slippi display name."><span class="name">Display name</span><span id="auth-name" class="readout"></span></div>
          <div class="row" data-desc="1-8 letters or digits. Used for LAN play."><span class="name">Local player name</span><input type="text" id="net-name" maxlength="8" value="PLAYER" /></div>
          <div class="row" data-desc="Automatic adapts to your connection. Changes apply next match."><span class="name">Input delay</span><button id="net-delay" class="value">Auto</button></div>
        </div>
        <div id="page-launcher" class="page">
          <div class="row" data-desc="The size of these menus."><span class="name">Interface size</span>
            <div class="slider-control"><input type="range" class="range" id="scale" min="75" max="150" step="25" value="100" /><span id="scale-val" class="slider-value">100%</span></div></div>
          <div class="row" data-desc="Look for a new release on GitHub at each start."><span class="name">Check for updates</span><button id="check-updates" class="value">On</button></div>
          <div class="row" id="check-row" data-desc="Look for a new release now."><span class="name">Updates <span id="check-status" class="detail">Xelee is up to date.</span></span><button id="check-now" class="value action">Check now</button></div>
          <div class="row" id="logs-row" data-desc="Send the logs of your last few sessions to the Xelee developer, for a bug report."><span class="name">Logs <span id="logs-status" class="detail">Send your recent logs with a bug report.</span></span><button id="logs-send" class="value action">Send</button></div>
          <div class="row" data-desc="Put the settings on this page back to how a new install has them."><span class="name">Defaults</span><button id="defaults-launcher" class="value action">Restore</button></div>
        </div>
        <p id="settings-status" style="display: none;"></p>
      </div>
    </div>
    <div id="descbar"><p id="desc">Pick a disc to play.</p></div>
  </div>
  <div id="camera-dialog" style="display: none;">
    <div class="dialog-box">
      <h2 id="camera-title">Roomtone uses the headset's cameras</h2>
      <p id="camera-body"></p>
      <div class="dialog-buttons"><button id="camera-allow" class="value action">Allow camera access</button><button id="camera-cancel" class="value action">Not now</button></div>
    </div>
  </div>
  <div id="hints" class="no-mobile no-quest">Arrows / D-Pad Move<span>Enter / A Select</span><span>Esc / B Back</span></div>
</body>
</rml>
