<?xml version="1.0" encoding="utf-8"?>
<!-- Merged over src/main/AndroidManifest.xml in XR builds (-Pmelee.xr=true):
     a Meta Quest hybrid app whose launcher is a 2D panel and whose game is
     immersive, and the entries the Khronos OpenXR loader needs to find the
     system runtime. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:metavr="http://schemas.meta.com/metavr-sdk">

    <!-- Hybrid (2D panel + immersive) apps need Horizon OS v69+. -->
    <metavr:uses-metavr-sdk
        metavr:minSdkVersion="69"
        metavr:targetSdkVersion="207" />

    <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1" />
    <!-- Meta only exposes XR_FB_passthrough to apps that declare this. -->
    <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="false" />
    <!-- Hand tracking (XR_EXT_hand_tracking): pinches place the arena. -->
    <uses-feature android:name="oculus.software.handtracking" android:required="false" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />
    <!-- XR_META_boundary_visibility: hide the Guardian boundary in mixed reality. -->
    <uses-permission android:name="com.oculus.permission.BOUNDARY_VISIBILITY" />
    <!-- Spatial data: XR_META_environment_raycast finds the real surface under
         the stage for its shadow (Quest 3 and 3S). The runtime offers it only
         to apps declaring this; its filter names the horizonos permission,
         Meta's docs the com.oculus one, so both. Asked for in the launcher
         panel (MeleeActivity.setLauncherActive). -->
    <uses-permission android:name="horizonos.permission.USE_SCENE" />
    <uses-permission android:name="com.oculus.permission.USE_SCENE" />
    <!-- Passthrough Camera API: while a room capture runs (the dev tools'
         Light page, source ROOM), one passthrough camera's frames, reduced to
         grids of mean colour, give the room's light for Roomtone lighting
         (dev.melee.RoomCapture; Quest 3 and 3S). Frames never leave the game.
         Asked for by the launcher only when the player picks Roomtone
         lighting, after it says why (MeleeActivity.requestHeadsetCamera). -->
    <uses-permission android:name="horizonos.permission.HEADSET_CAMERA" />

    <!-- Spatial anchors: the stage spot kept in the room across launches
         (XR_FB_spatial_entity, XR_META_spatial_entity_persistence and
         _discovery; the runtime hides them without it). -->
    <uses-permission android:name="horizonos.permission.USE_ANCHOR_API" />
    <uses-permission android:name="com.oculus.permission.USE_ANCHOR_API" />

    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent><action android:name="org.khronos.openxr.OpenXRRuntimeService" /></intent>
        <intent><action android:name="org.khronos.openxr.OpenXRApiLayerService" /></intent>
    </queries>

    <application>
        <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|questpro|quest3|quest3s" />
        <!-- Hybrid app (Meta's hybrid-apps guide): the launcher is a 2D panel;
             Play starts MeleeXrActivity and closes the panel. The main
             manifest's MAIN/LAUNCHER filter stays as the required fallback. -->
        <activity android:name="dev.melee.MeleeActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.oculus.intent.category.2D" />
            </intent-filter>
            <!-- Horizon OS's own default panel size (its panel sizing guide);
                 the launcher's Quest layout fits it without scrolling. -->
            <layout
                android:defaultWidth="1024dp"
                android:defaultHeight="640dp"
                android:minWidth="800dp"
                android:minHeight="500dp" />
        </activity>

        <!-- The game, immersive, in its own process: SDL keeps process-wide
             state, so it cannot share one with the launcher panel. -->
        <activity
            android:name="dev.melee.MeleeXrActivity"
            android:process=":xr"
            android:launchMode="singleTask"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
