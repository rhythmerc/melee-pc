/* The Slippi pages (src/pc/slippi_menu.cpp): Fight Controls' gold line work,
   drawn into the native page's red frame (src/melee/mn/mnslippi.c) over the
   running menu. No backdrop, title or footer: the page's frame, tab and hint
   box are Melee's. Laid out in px on a 1120x660 screen that the code scales
   into the frame (#screen's transform). */
* { box-sizing: border-box; }
body { width: 100%; height: 100%; margin: 0; font-family: "Noto Sans"; color: #fff8e0; background-color: #00000000; }
div, span { display: block; }
#screen { position: absolute; left: 0; top: 0; width: 1120px; height: 660px; transform-origin: 0 0; }
#board { position: absolute; left: 0; top: 0; width: 1120px; height: 660px; }

.h { font-size: 38px; font-weight: 800; color: #ffffff; }
.sub { font-size: 21px; color: #c9b77c; margin-top: 6px; }
.big { font-size: 42px; font-weight: 800; color: #ffe066; margin: 8px 0 24px; }
.text { font-size: 24px; color: #f0e4b8; }
.fine { font-size: 18px; color: #8d8468; margin-top: 22px; }
.fine.center { position: absolute; left: 0; width: 1120px; top: 628px; text-align: center; margin: 0; }

/* The step track: Melee's leader lines and dots. */
#track { position: absolute; left: 190px; width: 740px; top: 16px; height: 64px; }
#track .line { position: absolute; left: 0; width: 100%; top: 15px; height: 3px; background-color: #f0c22650; }
#track .line.done { background-color: #f0c226; box-shadow: #ffb020e0 0px 0px 8px 1px; }
.step { position: absolute; top: 0; width: 220px; margin-left: -110px; text-align: center; }
.step .dot { margin: 0 auto; width: 33px; height: 33px; border-radius: 17px; border: 3px #f0c22680; background-color: #0c0b08; }
.step .lbl { margin-top: 9px; font-size: 18px; font-weight: bold; letter-spacing: 1px; color: #8d8468; }
.step.done .dot { background-color: #f0c226; border-color: #f0c226; box-shadow: #ff9614c0 0px 0px 8px 1px; }
.step.done .lbl { color: #c9b77c; }
.step.now .dot { border-color: #fff4c4; background-color: #fff4c4; box-shadow: #ffb020 0px 0px 14px 4px; }
.step.now .lbl { color: #ffffff; }

/* Rows that open the keyboard, and buttons. */
.form { position: absolute; left: 200px; width: 720px; top: 46px; }
.form.review { top: 134px; }
.form .h { margin-bottom: 4px; }
.form .sub { margin-bottom: 28px; }
.field { position: relative; height: 84px; margin-bottom: 18px; padding: 14px 24px 0 26px; border: 3px #f0c226b0;
         border-radius: 8px; background-color: #0c0b08e0; box-shadow: #ff961450 0px 0px 10px 1px; }
.field .k { font-size: 16px; font-weight: bold; letter-spacing: 2px; color: #c9b77c; }
.field .v { margin-top: 6px; font-size: 30px; font-weight: bold; color: #fff8e0; }
.field .v.empty { margin-top: 9px; font-size: 24px; font-weight: normal; color: #6f6852; }
.field .edit { position: absolute; right: 20px; top: 24px; padding: 6px 14px; font-size: 19px; font-weight: bold;
               color: #c9b77c; border: 2px #f0c22680; border-radius: 6px; }
.field.cursor { border-color: #fff4c4; background-color: #1d180af0; box-shadow: #ffb020e0 0px 0px 16px 3px; }
.field.cursor .edit { color: #ffffff; border-color: #fff4c4; }
.field.bad { border-color: #ff8a5cc0; box-shadow: #ff5a3c60 0px 0px 12px 2px; }
.field.bad .k { color: #ff8a5c; }

.buttons { display: flex; margin-top: 8px; }
.btn { display: block; position: relative; height: 66px; padding-top: 15px; text-align: center; font-size: 28px; font-weight: bold;
       color: #f0e4b8; border: 3px #f0c226a0; border-radius: 8px; background-color: #0c0b08e0; }
.buttons .btn { width: 351px; margin-right: 18px; }
.buttons .btn:last-child { margin-right: 0; }
.btn.cursor { border-color: #fff4c4; color: #ffffff; background-color: #1d180af0; box-shadow: #ffb020e0 0px 0px 16px 3px; }
.btn.off { border-color: #f0c22640; color: #6f6852; box-shadow: none; }
.pulse { position: absolute; left: 26px; top: 24px; width: 16px; height: 16px; border-radius: 8px; background-color: #fff4c4;
         box-shadow: #ffb020 0px 0px 12px 5px; }

#note { margin-top: 22px; font-size: 22px; font-weight: bold; }
#note.bad { color: #ff8a5c; }
#note.good { color: #ffe066; }

/* X: Forgot password, Melee's button-hint chip (as Name Entry's Y SHIFT),
   at the frame's lower left. */
.chip { position: absolute; left: -44px; top: 676px; width: 172px; height: 132px; border: 3px #b8902e; border-radius: 18px;
        background-color: #050505; text-align: center; }
.chip.lit { border-color: #fff4c4; box-shadow: #ffb020e0 0px 0px 16px 3px; }
.chip.off { opacity: 0.4; }
.bean { width: 54px; height: 34px; margin: 16px auto 0; border-radius: 17px; background-color: #d8d8d8;
        font-size: 17px; font-weight: bold; color: #7b7b7b; line-height: 34px; transform: rotate(-12deg); }
.chip .lab { margin-top: 9px; font-size: 20px; font-weight: 800; color: #ffffff; line-height: 22px; }

/* The email step. */
.art { position: absolute; left: 60px; top: 130px; width: 400px; height: 363px; }
.side { position: absolute; left: 510px; width: 580px; top: 180px; }
.side .buttons .btn { width: 255px; }

/* The rules step. */
#rules { position: absolute; left: 28px; top: 138px; width: 650px; height: 510px; padding: 22px 30px 0 24px;
         border: 3px #f0c226b0; border-radius: 8px; background-color: #0c0b08e0; box-shadow: #ff961450 0px 0px 10px 1px; }
#rules .rh { font-size: 30px; font-weight: 800; color: #ffffff; margin-bottom: 8px; }
#rules .intro { font-size: 17px; color: #c9b77c; margin-bottom: 14px; line-height: 23px; }
.rule { display: flex; margin-bottom: 13px; }
.num { width: 42px; height: 42px; margin-right: 18px; border-radius: 21px; border: 3px #f0c226; text-align: center;
       font-size: 22px; font-weight: 800; line-height: 36px; color: #ffe066; box-shadow: #ff961460 0px 0px 8px 0px; }
.rt { width: 545px; font-size: 21px; color: #f0e4b8; line-height: 28px; }
#ticks { position: absolute; left: 706px; top: 138px; width: 386px; }
.chk { position: relative; height: 122px; margin-bottom: 20px; padding: 16px 18px 0 78px; border: 3px #f0c226b0;
       border-radius: 8px; background-color: #0c0b08e0; }
.chk.tall { height: 150px; }
.chk .box { position: absolute; left: 20px; top: 20px; width: 40px; height: 40px; border: 4px #f0c226; border-radius: 7px; }
.chk.ticked .box { background-color: #f0c226; box-shadow: #ff9614c0 0px 0px 10px 0px; }
.chk .t { font-size: 24px; font-weight: bold; color: #fff8e0; line-height: 29px; }
.chk .s { margin-top: 8px; font-size: 18px; color: #c9b77c; }
.chk .btnkey { display: inline; color: #ffe066; font-weight: bold; }
.chk.cursor { border-color: #fff4c4; background-color: #1d180af0; box-shadow: #ffb020e0 0px 0px 16px 3px; }
#ticks .btn { width: 386px; }

/* The tick in a done step's dot and a ticked box: an L turned 45 degrees. */
.mark { display: none; border-color: #1a1406; border-width: 0px 4px 4px 0px; transform: rotate(45deg); }
.step.done .mark { display: block; width: 8px; height: 15px; margin: 2px 0 0 9px; }
.chk.ticked .mark { display: block; width: 11px; height: 20px; margin: 2px 0 0 10px; border-width: 0px 5px 5px 0px; }

/* The connect code step. */
.codehead { position: absolute; left: 0; width: 1120px; top: 126px; text-align: center; font-size: 23px; color: #c9b77c; }
#tiles { position: absolute; left: 320px; top: 172px; width: 560px; height: 112px; display: flex; }
.cell { width: 90px; height: 110px; margin-right: 16px; border: 3px #f0c226b0; border-radius: 9px; background-color: #0c0b08e0;
        font-size: 72px; font-weight: 800; text-align: center; line-height: 104px; color: #ffffff; box-shadow: #ff961450 0px 0px 10px 1px; }
.cell.empty { border-color: #f0c22660; }
.cell.cur { border-color: #fff4c4; background-color: #1d180af0; box-shadow: #ffb020e0 0px 0px 16px 3px; }
.hash { margin-left: 8px; font-size: 60px; font-weight: 800; color: #8d8468; line-height: 110px; }
#keys { position: absolute; left: 209px; top: 310px; width: 714px; }
.key { display: inline-block; width: 66px; height: 56px; margin: 0 12px 12px 0; border: 2px #f0c22660; border-radius: 7px;
       background-color: #0c0b08c0; text-align: center; font-size: 29px; font-weight: bold; line-height: 52px; color: #e8dcb0; }
.key.wide { width: 144px; font-size: 21px; }
.key.confirm { width: 612px; font-size: 24px; color: #fff4c4; border-color: #f0c226a0; }
.key.confirm.off { color: #6f6852; border-color: #f0c22640; }
.key.cursor { border: 3px #fff4c4; color: #ffffff; background-color: #1d180af0; box-shadow: #ffb020e0 0px 0px 12px 2px; line-height: 50px; }
#board > #note { position: absolute; left: 0; width: 1120px; top: 592px; text-align: center; margin: 0; }

/* Done. */
#card { position: absolute; left: 260px; top: 150px; width: 600px; height: 320px; padding: 36px 44px 0;
        border: 3px #fff4c4; border-radius: 13px; background-color: #1a1408f0; box-shadow: #ffb020e0 0px 0px 22px 4px; }
#card .tag { font-size: 19px; font-weight: bold; letter-spacing: 3px; color: #c9b77c; }
#card .name { margin-top: 16px; font-size: 62px; font-weight: 800; color: #ffffff; }
#card .code { margin-top: 12px; font-size: 48px; font-weight: 800; letter-spacing: 3px; color: #ffe066; }
#card .sub { margin-top: 30px; }
#continue { position: absolute; left: 440px; top: 510px; width: 240px; }
